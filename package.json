{
    "name": "ytz-project-tracker",
    "private": true,
    "version": "1.0.0",
    "description": "AI-Powered Architecture Project Tracker",
    "author": "YEATZ",
    "main": "electron-main.js",
    "type": "commonjs",
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@hono/zod-validator": "^0.5.0",
        "hono": "4.7.7",
        "lucide-react": "^0.510.0",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "react-router": "^7.5.3",
        "zod": "^3.24.3"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.12.0",
        "@eslint/js": "9.25.1",
        "@getmocha/vite-plugins": "latest",
        "@getmocha/users-service": "^0.0.4",
        "@types/node": "22.14.1",
        "@types/react": "19.0.10",
        "@types/react-dom": "19.0.4",
        "@vitejs/plugin-react": "4.4.1",
        "autoprefixer": "^10.4.21",
        "electron": "^33.0.0",
        "electron-builder": "^25.1.8",
        "eslint": "9.25.1",
        "eslint-plugin-react-hooks": "5.2.0",
        "eslint-plugin-react-refresh": "0.4.19",
        "globals": "15.15.0",
        "postcss": "^8.5.3",
        "tailwindcss": "^3.4.17",
        "typescript": "5.8.3",
        "typescript-eslint": "8.31.0",
        "vite": "^7.1.3",
        "wrangler": "^4.33.0"
    },
    "scripts": {
        "build": "tsc -b && vite build",
        "cf-typegen": "wrangler types",
        "check": "tsc && vite build && wrangler deploy --dry-run",
        "dev": "vite",
        "lint": "eslint .",
        "electron:dev": "electron .",
        "electron:build": "npm run build && electron-builder build --win --publish never"
    },
    "build": {
        "appId": "com.yeatz.projecttracker",
        "productName": "YTZ Project Tracker",
        "copyright": "Copyright © 2026 YEATZ",
        "directories": {
            "output": "release_build"
        },
        "files": [
            "dist/**/*",
            "electron-main.js",
            "public/**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "public/Icon_01.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "YTZ Project Tracker"
        }
    }
}